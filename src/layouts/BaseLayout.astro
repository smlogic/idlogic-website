---
import '../styles/global.css';
import { BRAND_NAME } from '../config';

interface Props {
  lang: 'pl' | 'en';
  title: string;
  description: string;
  path?: string;
  robots?: string;
  alternateLanguages?: boolean;
}

const { lang, title, description, path = '', robots, alternateLanguages = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const localPath = lang === 'pl' ? path : `en/${path}`;
const canonical = Astro.site ? new URL(`${base}${localPath}`, Astro.site) : undefined;
const plUrl = Astro.site ? new URL(`${base}${path}`, Astro.site) : undefined;
const enUrl = Astro.site ? new URL(`${base}en/${path}`, Astro.site) : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#0d1117" />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternateLanguages && plUrl && <link rel="alternate" hreflang="pl" href={plUrl} />}
    {alternateLanguages && enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {alternateLanguages && plUrl && <link rel="alternate" hreflang="x-default" href={plUrl} />}
    <link rel="icon" href={`${base}favicon.ico?v=20261028-dark`} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={`${base}favicon.svg?v=20261028-dark`} type="image/svg+xml" sizes="any" />
    <link rel="icon" href={`${base}favicon-192.png?v=20261028-dark`} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png?v=20261028-dark`} sizes="180x180" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_NAME} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
    {alternateLanguages && <meta property="og:locale:alternate" content={lang === 'pl' ? 'en_US' : 'pl_PL'} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <slot />
  </body>
</html>
