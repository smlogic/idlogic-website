---
import { BRAND_NAME, QUESTIONNAIRE_URL } from '../config';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  path?: string;
  nav: {
    solutions: string;
    approach: string;
    privacy: string;
    contact: string;
    survey: string;
  };
}

const { lang, nav, path = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const plHref = `${base}${path}`;
const enHref = `${base}en/${path}`;
const homeHref = lang === 'pl' ? base : `${base}en/`;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={homeHref} aria-label={`${BRAND_NAME} — home`}>
      <img class="brand-icon" src={`${base}logo-black.png`} width="43" height="27" alt="" />
      <span>{BRAND_NAME}</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <a href={`${homeHref}#rozwiazania`}>{nav.solutions}</a>
      <a href={`${homeHref}#proces`}>{nav.approach}</a>
      <a href={`${homeHref}#prywatnosc`}>{nav.privacy}</a>
      <a href={`${homeHref}#kontakt`}>{nav.contact}</a>
    </nav>

    <div class="header-actions">
      <div class="language-switch" aria-label="Language">
        <a class:list={[{ active: lang === 'pl' }]} href={plHref} lang="pl">PL</a>
        <span>/</span>
        <a class:list={[{ active: lang === 'en' }]} href={enHref} lang="en">EN</a>
      </div>
      <a class="button button-small button-ghost" href={QUESTIONNAIRE_URL} target="_blank" rel="noreferrer">
        {nav.survey}
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <details class="mobile-menu">
      <summary aria-label="Open menu"><span></span><span></span></summary>
      <div class="mobile-panel">
        <nav aria-label="Mobile navigation">
          <a href={`${homeHref}#rozwiazania`}>{nav.solutions}</a>
          <a href={`${homeHref}#proces`}>{nav.approach}</a>
          <a href={`${homeHref}#prywatnosc`}>{nav.privacy}</a>
          <a href={`${homeHref}#kontakt`}>{nav.contact}</a>
        </nav>
        <div class="mobile-panel-bottom">
          <div class="language-switch">
            <a class:list={[{ active: lang === 'pl' }]} href={plHref}>PL</a><span>/</span><a class:list={[{ active: lang === 'en' }]} href={enHref}>EN</a>
          </div>
          <a class="button button-dark" href={QUESTIONNAIRE_URL} target="_blank" rel="noreferrer">{nav.survey} ↗</a>
        </div>
      </div>
    </details>
  </div>
</header>
