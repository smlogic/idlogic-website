---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import { BRAND_NAME, DEMO_URL } from '../config';
import { copy, type Lang } from '../i18n';
import { smartHomeCopy } from '../smartHome';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = smartHomeCopy[lang];
const base = import.meta.env.BASE_URL;
const home = lang === 'pl' ? base : `${base}en/`;
const image = (file: string) => `${base}smart-home/${file}`;
const ids = ['demo', 'lighting', 'climate', 'shading', 'water', 'alerts', 'energy'];
const firstScene = t.lighting.scenes[0];
const firstMode = t.demo.modes[0];
const sceneSizes: Record<string, [number, number]> = {
  'scene-relax.webp': [1771, 995], 'scene-cleaning.webp': [1573, 884],
  'scene-night.webp': [1774, 999], 'scene-off.webp': [1652, 928]
};
const imageSizes: Record<string, [number, number]> = {
  climate: [1407, 794], shading: [1418, 787], water: [1415, 785],
  alerts: [1418, 776], energy: [1576, 1637]
};
---
<BaseLayout lang={lang} title={t.metaTitle} description={t.metaDescription} path="smart-home/">
  <main class="smart-page">
    <section class="smart-hero">
      <Header lang={lang} nav={copy[lang].nav} path="smart-home/" />
      <div class="shell smart-hero-content">
        <a class="smart-back" href={home}><span aria-hidden="true">←</span> {t.back}</a>
        <div class="smart-hero-heading">
          <div>
            <p class="section-kicker">{t.eyebrow}</p>
            <h1>{t.title}</h1>
          </div>
          <p>{t.intro}</p>
        </div>
        <figure class="smart-hero-visual">
          <a href={image('overview-private.webp')} target="_blank" rel="noopener" aria-label={t.previewOpen}>
            <img src={image('overview-private.webp')} width="1672" height="941" alt={t.previewLabel} fetchpriority="high" />
          </a>
          <figcaption><span class="smart-visual-dot" aria-hidden="true"></span>{t.previewLabel}<span class="smart-visual-open">{t.previewOpen} ↗</span></figcaption>
        </figure>
        <p class="smart-preview-note">{t.previewNote}</p>
      </div>
    </section>

    <nav class="smart-jump" aria-label={t.jumpLabel}>
      <div class="shell smart-jump-inner">
        <span class="smart-jump-label">{t.jumpLabel}</span>
        <div class="smart-jump-links">
          {ids.map((id, i) => <a href={`#${id}`}>{t.nav[i]} <span aria-hidden="true">↗</span></a>)}
        </div>
      </div>
    </nav>

    <section class="smart-demo" id="demo" aria-labelledby="smart-demo-title">
      <div class="shell">
        <div class="smart-demo-heading">
          <div><p class="section-kicker">{t.demo.eyebrow}</p><h2 id="smart-demo-title">{t.demo.title}</h2></div>
          <p>{t.demo.intro}</p>
        </div>
        <div class="smart-demo-modes" role="group" aria-label={t.demo.label}>
          {t.demo.modes.map((mode, i) => (
            <button type="button" class:list={['smart-demo-mode', { active: i === 0 }]} data-demo-select data-image={image(mode.image)} data-alt={mode.alt} data-description={mode.description} data-states={JSON.stringify(mode.states)} data-width={sceneSizes[mode.image][0]} data-height={sceneSizes[mode.image][1]} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{mode.title}
            </button>
          ))}
        </div>
        <div class="smart-demo-grid">
          <figure class="smart-demo-visual">
            <a data-demo-full href={image(firstMode.image)} target="_blank" rel="noopener" aria-label={t.demo.open}>
              <img data-demo-image src={image(firstMode.image)} width={sceneSizes[firstMode.image][0]} height={sceneSizes[firstMode.image][1]} alt={firstMode.alt} decoding="async" />
            </a>
            <figcaption>{t.demo.caption}</figcaption>
          </figure>
          <div class="smart-demo-story" aria-live="polite" aria-atomic="true">
            <p class="smart-demo-description" data-demo-description>{firstMode.description}</p>
            <dl class="smart-demo-states">
              {t.demo.features.map((feature, i) => (
                <div><dt>{feature}</dt><dd data-demo-state>{firstMode.states[i]}</dd></div>
              ))}
            </dl>
          </div>
        </div>
        <a class="text-link smart-demo-link" href={DEMO_URL} target="_blank" rel="noopener noreferrer">{t.demo.fullDemo}<span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="smart-lighting section" id="lighting">
      <div class="shell">
        <div class="smart-section-heading">
          <div><p class="section-kicker">{t.lighting.eyebrow}</p><h2>{t.lighting.title}</h2></div>
          <p>{t.lighting.text}</p>
        </div>
        <div class="smart-view-switcher" role="group" aria-label={t.lighting.viewLabel}>
          <button class="smart-view-button active" type="button" data-lighting-view="scenes" aria-pressed="true">{t.lighting.scenesView}</button>
          <button class="smart-view-button" type="button" data-lighting-view="controls" data-image={image('lighting.webp')} data-alt={t.lighting.controlsAlt} data-caption={t.lighting.controlsView} aria-pressed="false">{t.lighting.controlsView}</button>
        </div>
        <div class="smart-scene-switcher" data-scene-switcher role="group" aria-label={t.lighting.sceneLabel}>
          {t.lighting.scenes.map((scene, i) => (
            <button type="button" class:list={['smart-scene-button', { active: i === 0 }]} data-scene-select data-image={image(scene.image)} data-alt={scene.alt} data-detail={scene.detail} data-width={sceneSizes[scene.image][0]} data-height={sceneSizes[scene.image][1]} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="smart-scene-indicator" aria-hidden="true"></span>
              <strong>{scene.title}</strong>
              <small>{scene.detail}</small>
            </button>
          ))}
        </div>
        <figure class="smart-scene-visual">
          <a data-scene-full href={image(firstScene.image)} target="_blank" rel="noopener" aria-label={firstScene.alt}>
            <img data-scene-preview src={image(firstScene.image)} width="1771" height="995" alt={firstScene.alt} decoding="async" loading="lazy" />
          </a>
          <figcaption data-scene-caption aria-live="polite">{firstScene.detail}</figcaption>
        </figure>
      </div>
    </section>

    {t.sections.map((section, i) => (
      <section class:list={['smart-feature', { 'smart-feature-alt': i % 2 === 1 }]} id={section.id}>
        <div class="shell smart-feature-grid">
          <div class="smart-feature-copy">
            <p class="section-kicker">{section.eyebrow}</p>
            <h2>{section.title}</h2>
            <p>{section.text}</p>
          </div>
          {section.id === 'climate' ? (
            <div class="smart-climate-gallery">
              <div class="smart-view-switcher" role="group" aria-label={t.climatePlan.label}>
                <button class="smart-view-button active" type="button" data-climate-select data-image={image('climate-plan.webp')} data-alt={t.climatePlan.alt} data-width="1423" data-height="788" aria-pressed="true">{t.climatePlan.plan}</button>
                <button class="smart-view-button" type="button" data-climate-select data-image={image(section.image)} data-alt={section.alt} data-width="1407" data-height="794" aria-pressed="false">{t.climatePlan.settings}</button>
              </div>
              <a class="smart-feature-image" data-climate-full href={image('climate-plan.webp')} target="_blank" rel="noopener" aria-label={t.climatePlan.alt}>
                <img data-climate-preview src={image('climate-plan.webp')} width="1423" height="788" alt={t.climatePlan.alt} loading="lazy" decoding="async" />
              </a>
            </div>
          ) : (
            <a class="smart-feature-image" href={image(section.image)} target="_blank" rel="noopener" aria-label={section.alt}>
              <img src={image(section.image)} width={imageSizes[section.id][0]} height={imageSizes[section.id][1]} alt={section.alt} loading="lazy" decoding="async" />
            </a>
          )}
        </div>
      </section>
    ))}

    <section class="smart-final">
      <div class="shell smart-final-inner">
        <div><p class="section-kicker">Smart home · IDLogic</p><h2>{t.ctaTitle}</h2></div>
        <div><p>{t.ctaBody}</p><a class="button button-dark" href={`${home}#kontakt`}>{t.cta}<span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
  </main>
  <footer class="footer smart-footer"><div class="shell smart-footer-inner">
    <a class="brand brand-footer" href={home}><img class="brand-icon" src={`${base}logo-white.png`} width="43" height="27" alt="" loading="lazy" /><span>{BRAND_NAME}</span></a>
    <a href={home}>{t.back} ↗</a>
    <div class="language-switch"><a class:list={[{ active: lang === 'pl' }]} href={`${base}smart-home/`} lang="pl">PL</a><span>/</span><a class:list={[{ active: lang === 'en' }]} href={`${base}en/smart-home/`} lang="en">EN</a></div>
  </div></footer>
</BaseLayout>

<script>
  const demoButtons = document.querySelectorAll<HTMLButtonElement>('[data-demo-select]');
  const demoImage = document.querySelector<HTMLImageElement>('[data-demo-image]');
  const demoFull = document.querySelector<HTMLAnchorElement>('[data-demo-full]');
  const demoDescription = document.querySelector<HTMLElement>('[data-demo-description]');
  const demoStates = document.querySelectorAll<HTMLElement>('[data-demo-state]');
  demoButtons.forEach((button) => button.addEventListener('click', () => {
    if (!demoImage || !demoFull || !demoDescription) return;
    demoButtons.forEach((item) => { item.classList.remove('active'); item.setAttribute('aria-pressed', 'false'); });
    button.classList.add('active');
    button.setAttribute('aria-pressed', 'true');
    demoImage.src = button.dataset.image || demoImage.src;
    demoImage.alt = button.dataset.alt || demoImage.alt;
    demoImage.width = Number(button.dataset.width) || demoImage.width;
    demoImage.height = Number(button.dataset.height) || demoImage.height;
    demoFull.href = demoImage.src;
    demoDescription.textContent = button.dataset.description || '';
    const states = JSON.parse(button.dataset.states || '[]') as string[];
    demoStates.forEach((state, i) => { state.textContent = states[i] || ''; });
  }));

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-scene-select]');
  const preview = document.querySelector<HTMLImageElement>('[data-scene-preview]');
  const fullImage = document.querySelector<HTMLAnchorElement>('[data-scene-full]');
  const caption = document.querySelector<HTMLElement>('[data-scene-caption]');
  const sceneSwitcher = document.querySelector<HTMLElement>('[data-scene-switcher]');
  const lightingViews = document.querySelectorAll<HTMLButtonElement>('[data-lighting-view]');
  const showLightingImage = (button: HTMLButtonElement) => {
    if (!preview || !caption) return;
    preview.src = button.dataset.image || preview.src;
    preview.alt = button.dataset.alt || preview.alt;
    preview.width = Number(button.dataset.width) || (button.dataset.lightingView === 'controls' ? 1417 : preview.width);
    preview.height = Number(button.dataset.height) || (button.dataset.lightingView === 'controls' ? 796 : preview.height);
    if (fullImage) {
      fullImage.href = preview.src;
      fullImage.setAttribute('aria-label', preview.alt);
    }
    caption.textContent = button.dataset.detail || button.dataset.caption || '';
  };
  buttons.forEach((button) => button.addEventListener('click', () => {
    buttons.forEach((item) => { item.classList.remove('active'); item.setAttribute('aria-pressed', 'false'); });
    button.classList.add('active');
    button.setAttribute('aria-pressed', 'true');
    showLightingImage(button);
  }));
  lightingViews.forEach((button) => button.addEventListener('click', () => {
    lightingViews.forEach((item) => { item.classList.remove('active'); item.setAttribute('aria-pressed', 'false'); });
    button.classList.add('active');
    button.setAttribute('aria-pressed', 'true');
    const controls = button.dataset.lightingView === 'controls';
    if (sceneSwitcher) sceneSwitcher.hidden = controls;
    if (controls) showLightingImage(button);
    else {
      const activeScene = Array.from(buttons).find((item) => item.getAttribute('aria-pressed') === 'true') || buttons[0];
      if (activeScene) showLightingImage(activeScene);
    }
  }));

  const climateButtons = document.querySelectorAll<HTMLButtonElement>('[data-climate-select]');
  const climatePreview = document.querySelector<HTMLImageElement>('[data-climate-preview]');
  const climateFull = document.querySelector<HTMLAnchorElement>('[data-climate-full]');
  climateButtons.forEach((button) => button.addEventListener('click', () => {
    if (!climatePreview || !climateFull) return;
    climateButtons.forEach((item) => { item.classList.remove('active'); item.setAttribute('aria-pressed', 'false'); });
    button.classList.add('active');
    button.setAttribute('aria-pressed', 'true');
    climatePreview.src = button.dataset.image || climatePreview.src;
    climatePreview.alt = button.dataset.alt || climatePreview.alt;
    climatePreview.width = Number(button.dataset.width) || climatePreview.width;
    climatePreview.height = Number(button.dataset.height) || climatePreview.height;
    climateFull.href = climatePreview.src;
    climateFull.setAttribute('aria-label', climatePreview.alt);
  }));
</script>
