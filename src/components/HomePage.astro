---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import FeatureCard from './FeatureCard.astro';
import { BRAND_NAME, CONTACT_EMAIL, DEMO_URL, QUESTIONNAIRE_URL } from '../config';
import { copy, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const base = import.meta.env.BASE_URL;
const currentYear = new Date().getFullYear();
---
<BaseLayout lang={lang} title={t.metaTitle} description={t.metaDescription}>
  <main>
    <section
      class="hero"
      style={`--hero-image:url('${base}gradient-about-header.jpg');--noise-image:url('${base}noise.png')`}
    >
      <Header lang={lang} nav={t.nav} />
      <div class="shell hero-inner">
        <div class="announcement-row">
          <a class="announcement" href={DEMO_URL} target="_blank" rel="noopener noreferrer">
            <img class="announcement-image" src={`${base}smart-home/scene-cleaning.webp`} alt="" width="1573" height="884" decoding="async" />
            <span class="announcement-copy">
              <span class="announcement-eyebrow">{t.announcement.eyebrow}</span>
              <strong class="announcement-title">{t.announcement.title}</strong>
              <span class="announcement-detail">{t.announcement.detail}</span>
            </span>
            <span class="announcement-arrow" aria-hidden="true">↗</span>
          </a>
          <div class="announcement announcement-placeholder">
            <span class="announcement-image announcement-image-empty" aria-hidden="true"></span>
            <span class="announcement-copy">
              <span class="announcement-eyebrow">{t.officePreview.status}</span>
              <strong class="announcement-title">Smart office</strong>
            </span>
          </div>
        </div>

        <div class="hero-grid">
          <div class="hero-side">
            <p class="eyebrow">{t.hero.eyebrow}</p>
            <p class="hero-intro">{t.hero.body}</p>
          </div>
          <h1 class="hero-type">
            <span class="sr-only">{t.hero.accessibleTitle}</span>
            <span class="hero-first" aria-hidden="true">{t.hero.first}</span>
            <span class="hero-word-window" aria-hidden="true">
              <span class="hero-word-stack">
                {t.hero.words.map((word, i) => <span class:list={[{ lineword: i === 3 }]}>{i === 3 ? <small>{t.hero.wordPrompt}</small> : word}</span>)}
                <span>{t.hero.words[0]}</span>
              </span>
            </span>
            <span class="hero-noun" aria-hidden="true">{t.hero.noun}</span>
          </h1>
        </div>

        <div class="hero-bottom">
          <div class="hero-cta-row">
            <a class="button button-dark" href={QUESTIONNAIRE_URL} target="_blank" rel="noreferrer">{t.hero.primary}<span>↗</span></a>
            <a class="text-link" href="#proces">{t.hero.secondary}<span>↓</span></a>
          </div>
          <p class="hero-note">{t.hero.note}</p>
        </div>
      </div>
    </section>

    <section class="section section-intro" id="rozwiazania">
      <div class="shell split-heading">
        <p class="section-kicker">{t.intro.kicker}</p>
        <div>
          <h2>{t.intro.title}</h2>
          <p class="lead">{t.intro.body}</p>
        </div>
      </div>
      <div class="shell cards-grid">
        {t.cards.map((card, index) => <FeatureCard card={card} index={index} lang={lang} />)}
      </div>
    </section>

    <section class="section section-dark" id="prywatnosc">
      <div class="shell privacy-grid">
        <div class="privacy-orbit" aria-hidden="true">
          <div class="orbit orbit-a"></div>
          <div class="orbit orbit-b"></div>
          <div class="orbit-center"><span>ID</span></div>
        </div>
        <div class="privacy-copy">
          <p class="section-kicker section-kicker-light">{t.principle.kicker}</p>
          <h2>{t.principle.title}</h2>
          <p class="lead lead-dark">{t.principle.body}</p>
          <ul class="check-list">
            {t.principle.bullets.map((item) => <li><span>✓</span>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section process" id="proces">
      <div class="shell split-heading process-heading">
        <p class="section-kicker">{t.process.kicker}</p>
        <h2>{t.process.title}</h2>
      </div>
      <div class="shell steps">
        {t.process.steps.map(([title, text], index) => (
          <article class="step">
            <span class="step-icon" aria-hidden="true">
              {index === 0 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="17" rx="2"/><path d="M8 4.5V3h8v1.5M8 10h8M8 14h8M8 18h5"/></svg>}
              {index === 1 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6m-5 3h4m-5-6c-1.7-1.2-2.5-2.8-2.5-4.7a5.5 5.5 0 0 1 11 0c0 1.9-.8 3.5-2.5 4.7V18H9z"/><path d="M12 2v1"/></svg>}
              {index === 2 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V6l7-3 7 3v15M9 9h6M9 13h6M10 21v-4h4v4"/></svg>}
              {index === 3 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18 9 12l4 4 8-9M16 7h5v5"/></svg>}
            </span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section local-section">
      <div class="shell local-card">
        <div>
          <p class="section-kicker">{t.local.kicker}</p>
          <h2>{t.local.title}</h2>
        </div>
        <div class="local-copy">
          <p>{t.local.body}</p>
          <a class="text-link" href={QUESTIONNAIRE_URL} target="_blank" rel="noreferrer">{t.local.cta}<span>↗</span></a>
        </div>
        <div class="warsaw-mark" aria-hidden="true">
          <span>52.2297° N</span>
          <strong>WAW</strong>
          <span>21.0122° E</span>
        </div>
      </div>
    </section>

    <section class="section final-cta" id="kontakt">
      <div class="shell final-cta-inner">
        <div>
          <p class="section-kicker">{t.finalCta.overline}</p>
          <h2>{t.finalCta.title}</h2>
        </div>
        <div class="final-copy">
          <p>{t.finalCta.body}</p>
          <a class="button button-dark button-large" href={QUESTIONNAIRE_URL} target="_blank" rel="noreferrer">
            {t.finalCta.button}<span>↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="shell footer-grid">
      <div>
        <a class="brand brand-footer" href={lang === 'pl' ? base : `${base}en/`}>
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>{BRAND_NAME}</span>
        </a>
        <p>{t.footer.tagline}</p>
      </div>
      <div class="footer-meta">
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <span>{t.footer.location}</span>
      </div>
      <div class="footer-bottom">
        <span>© {currentYear} {BRAND_NAME}. {t.footer.rights}</span>
        <div class="language-switch footer-language">
          <a class:list={[{ active: lang === 'pl' }]} href={base}>PL</a><span>/</span><a class:list={[{ active: lang === 'en' }]} href={`${base}en/`}>EN</a>
        </div>
      </div>
    </div>
  </footer>
</BaseLayout>
